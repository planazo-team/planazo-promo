# Variables de entorno del servicio. Copia este archivo a `.env` para desarrollo
# local (el .env real NO se sube al repo). En Railway se configuran en el panel.

# Nombre del servicio. Aparece en GET /health y en los logs.
SERVICE_NAME=planazo-promo

# Puerto HTTP en el que escucha el servicio (Railway inyecta PORT automáticamente).
PORT=3002

# Clave compartida con el API Gateway. Si está definida, toda ruta salvo
# GET /health exige el header `x-gateway-key` con este valor (401 GATEWAY_KEY_INVALIDA).
# Déjala vacía o sin definir en desarrollo para poder llamar al servicio directo.
# GATEWAY_KEY=cambia-esta-clave

# URL de Redis del bus de eventos (pub/sub). Si no está definida, publicar
# eventos es un no-op con un warn en el log; el servicio funciona sin Redis.
# BUS_URL=redis://localhost:6379

# Canal de Redis al que se publican los eventos del bus.
BUS_CHANNEL=planazo.events

# Cadena de conexión a la base de datos propia del servicio (si aplica).
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/planazo

# URL de Redis para uso propio del servicio (stock atómico, cachés...).
# Puede ser la misma instancia que BUS_URL.
# REDIS_URL=redis://localhost:6379

# Secreto JWT. Los servicios NO validan JWT (lo hace el gateway); solo se
# declara aquí por si un servicio necesita firmar tokens (p. ej. realtime).
# JWT_SECRET=cambia-este-secreto

# Nivel mínimo de log: debug | log | warn | error.
LOG_LEVEL=log
